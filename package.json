{
  "name": "blog.laudebugs.me",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "biome check . && ASTRO_TELEMETRY_DISABLED=1 astro check --tsconfig tsconfig.site.json && tsc --noEmit -p tsconfig.site.json",
    "test": "vitest run",
    "fmt": "biome format --write .",
    "parity": "node scripts/parity.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@codesandbox/sandpack-react": "2.20.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@types/react": "19.1.10",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.8",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@biomejs/biome": "2.6.8",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/karla": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@module-federation/enhanced": "0.22.1",
    "@nx/module-federation": "22.4.0",
    "@shikijs/transformers": "4.6.0",
    "@shikijs/twoslash": "4.6.0",
    "@types/node": "20.19.10",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.13",
    "pagefind": "1.6.0",
    "remark-directive": "4.0.0",
    "rxjs": "7.8.2",
    "shiki": "4.6.0",
    "sucrase": "3.35.1",
    "unist-util-visit": "5.2.0",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "mdast-util-to-hast@>=13.0.0 <13.2.1": "13.2.2",
      "yaml@>=2.0.0 <2.8.3": "2.9.1",
      "source-map-js@<1.2.2": "1.2.4"
    }
  }
}
