{
  "name": "blog.laudebugs.me",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node docs/helpers/gen-post-archive.js && vocs dev",
    "prebuild": "node docs/helpers/gen-post-archive.js",
    "build": "node docs/helpers/gen-post-archive.js && vocs build",
    "preview": "vocs preview",
    "gen-types": "npx -p typescript tsc docs/helpers/*.js --declaration --allowJs --emitDeclarationOnly",
    "site:dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "site:build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "site:preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "site:check": "biome check . && ASTRO_TELEMETRY_DISABLED=1 astro check --tsconfig tsconfig.site.json && tsc --noEmit -p tsconfig.site.json",
    "site:test": "vitest run",
    "site:fmt": "biome format --write ."
  },
  "dependencies": {
    "@angular/core": "^21.1.1",
    "@angular/router": "^21.1.1",
    "@angular/platform-browser": "^21.1.1",
    "@codesandbox/sandpack-react": "^2.12.0",
    "@module-federation/enhanced": "^0.22.1",
    "@nx/module-federation": "^22.4.0",
    "@stackblitz/sdk": "^1.9.0",
    "@types/react": "latest",
    "@uidotdev/usehooks": "^2.4.1",
    "date-fns": "^3.3.1",
    "feed": "^4.2.2",
    "feed-core": "^1.1.6",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "react": "latest",
    "react-dom": "latest",
    "rxjs": "^7.8.1",
    "typescript": "6.0.3",
    "vocs": "1.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "astro": "7.4.13",
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.9",
    "vitest": "5.1.2",
    "@fontsource/lora": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@astrojs/mdx": "8.1.6",
    "remark-directive": "4.0.0",
    "unist-util-visit": "5.2.0",
    "@astrojs/markdown-remark": "7.3.8"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "printWidth": 130
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
