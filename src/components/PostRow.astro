---
import { postPath, type Post } from '../lib/posts';
import { shortDate } from '../lib/tags';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<a class="row" href={postPath(post)}>
  <span class="mono date">{shortDate(post.data.publishedOn)}</span>
  <b class="title">{post.data.title}</b>
  <span class="mono tags">{post.data.tags.slice(0, 2).join(', ')}</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) 190px;
    gap: 20px;
    align-items: baseline;
    padding: 15px 0;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--grid);
    background: color-mix(in srgb, var(--paper) 85%, transparent);
  }

  .title {
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.28;
  }

  .row:hover .title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .date,
  .tags {
    color: var(--dim);
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
