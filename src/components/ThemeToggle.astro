---
// Hidden until the script runs, so a reader without JavaScript never sees a button that does nothing.
---

<button type="button" class="theme-toggle mono" data-theme-toggle hidden>dark</button>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle';
  initThemeToggle();
</script>

<style>
  .theme-toggle {
    min-height: 44px;
    padding: 0 12px;
    color: inherit;
    cursor: pointer;
    background: color-mix(in srgb, var(--tone-a) 65%, transparent);
    border: 0;
  }
</style>
