---
interface Props {
  src: string;
}
const { src } = Astro.props;
---

<div class="embed">
  <iframe
    src={src}
    width="100%"
    height="152"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
    title="Spotify track"></iframe>
</div>
