---
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="top wrap">
  <a class="brand" href="/" aria-label="Laurence Ininda's blog, home">
    <span class="mark"><Mark size={42} /></span>
    <span class="name">Laurence Ininda <i>/ blog</i></span>
  </a>
  <nav class="mono" aria-label="Main">
    <a href="/archive">archive</a>
    <a href="/topics">topics</a>
    <a href="https://laudebugs.me">laudebugs.me ↗</a>
    <a href="https://github.com/laudebugs">github ↗</a>
    <ThemeToggle />
  </nav>
</header>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 22px;
    padding-bottom: 16px;
    /* A rule under the header, not a box. */
    border-bottom: 2px solid var(--ink);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .mark {
    display: block;
    color: var(--accent);
    line-height: 0;
  }

  .name {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .name i {
    color: var(--accent);
    font-weight: 400;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
</style>
