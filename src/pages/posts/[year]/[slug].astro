---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { allPosts, postYear } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, index) => ({
    params: { year: postYear(post), slug: post.data.slug },
    props: { post, previous: posts[index - 1], next: posts[index + 1] },
  }));
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---

<Article post={post} headings={headings} previous={previous} next={next}>
  <Content />
</Article>
