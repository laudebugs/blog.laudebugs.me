---
import PostRow from '../../components/PostRow.astro';
import Base from '../../layouts/Base.astro';
import { allPosts } from '../../lib/posts';
import { countTags } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await allPosts();
  return countTags(posts.map((post) => post.data)).map(({ tag, slug, count }) => ({
    params: { tag: slug },
    props: { tag, count, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, count, posts } = Astro.props;
---

<Base title={`${tag} | Laurence Ininda / blog`} description={`Posts about ${tag}, newest first.`}>
  <p class="mono kicker">topic</p>
  <h1><em>{tag}</em></h1>
  <p class="lede">{count} {count === 1 ? 'post' : 'posts'}, newest first.</p>
  {posts.map((post) => <PostRow post={post} />)}
</Base>

<style>
  .kicker {
    margin: 34px 0 0;
    color: var(--dim);
  }

  h1 {
    margin-top: 6px;
  }
</style>
