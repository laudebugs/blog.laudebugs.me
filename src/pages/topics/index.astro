---
import Base from '../../layouts/Base.astro';
import { allPosts } from '../../lib/posts';
import { countTags } from '../../lib/tags';

const posts = await allPosts();
const tags = countTags(posts.map((post) => post.data));
const big = tags.slice(0, 6);
const small = tags.slice(6);
const titles = (tag: string) => posts.filter((post) => post.data.tags.includes(tag)).slice(0, 2);
const tones = ['a', 'b', 'c', 'd'];
---

<Base title="Topics | Laurence Ininda / blog" description="Every topic, with its posts.">
  <h1>Topics</h1>
  <p class="lede">{tags.length} topics. {tags[0]?.tag} is where most of the writing is.</p>

  <div class="cards">
    {
      big.map((item, index) => (
        <a class={`card tone-${tones[index % tones.length]}`} href={`/topics/${item.slug}`}>
          <h2>
            {item.tag} <span class="mono">{item.count} {item.count === 1 ? 'post' : 'posts'}</span>
          </h2>
          {titles(item.tag).map((post) => (
            <p>{post.data.title}</p>
          ))}
        </a>
      ))
    }
  </div>

  {
    small.length > 0 && (
      <>
        <p class="mono more">more topics</p>
        <ul class="chips mono">
          {small.map((item) => (
            <li>
              <a href={`/topics/${item.slug}`}>
                {item.tag} <b>{item.count}</b>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
    margin-bottom: 28px;
  }

  /* A card is a tinted section in one of the four tones, with no border. */
  .card {
    padding: 16px 18px;
    color: inherit;
    text-decoration: none;
    background: color-mix(in srgb, var(--ink-tone) 13%, var(--paper));
  }

  .tone-a {
    --ink-tone: var(--tone-a-ink);
  }
  .tone-b {
    --ink-tone: var(--tone-b-ink);
  }
  .tone-c {
    --ink-tone: var(--tone-c-ink);
  }
  .tone-d {
    --ink-tone: var(--tone-d-ink);
  }

  .card h2 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 0 4px;
    color: var(--ink-tone);
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .card h2 span {
    font-size: 0.78rem;
    font-weight: 400;
  }

  .card p {
    margin: 8px 0 0;
    color: var(--dim);
    font-size: 0.98rem;
    line-height: 1.35;
  }

  .card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .more {
    margin: 0 0 8px;
    color: var(--dim);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips a {
    display: inline-block;
    padding: 4px 10px;
    color: var(--tone-a-ink);
    text-decoration: none;
    background: color-mix(in srgb, var(--tone-a) 65%, transparent);
  }

  .chips b {
    font-weight: 500;
  }
</style>
