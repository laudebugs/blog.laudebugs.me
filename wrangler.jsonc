{
  // The blog is static files in dist/, served by Cloudflare Workers static assets. There is no Worker script.
  // Each deploy keeps blog.laudebugs.me attached to this Worker (docs/guides/migrate-to-cloudflare.md, step 8).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog-laudebugs-me",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    // The old site had no trailing slash (/posts/2025/slug), and posts-index.json and the feed use that form,
    // so that is the canonical one; /posts/2025/slug/ redirects to it.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "blog.laudebugs.me", "custom_domain": true }],
  // Wrangler refuses to make a pull request preview (.github/workflows/preview.yml) without this block.
  "previews": {},
  "workers_dev": true
}
